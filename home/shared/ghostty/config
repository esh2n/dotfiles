# Ghostty Terminal Configuration, shared by macOS and Linux.
# What differs per OS (keybinds, the theme, window chrome) is in `platform`,
# read last so it wins: home/<os>/ghostty/platform.
# Modern, fast terminal emulator with GPU acceleration
# Enhanced for a rich, professional look

# Window settings
window-height = 45
window-width = 140
window-padding-x = 24
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
window-decoration = auto
window-theme = dark
window-inherit-working-directory = true
window-inherit-font-size = true

# Font configuration
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true
adjust-cell-height = 20%
adjust-underline-position = 10%
adjust-underline-thickness = 50%

# Enable ligatures for better code aesthetics
font-feature = +liga
font-feature = +calt
font-feature = +ss01
font-feature = +ss02
font-feature = +ss03
font-feature = +ss04
font-feature = +ss05

# Theme and appearance
background-opacity = 0.8
background-blur-radius = 30
unfocused-split-opacity = 0.80
unfocused-split-fill = #1f2335
split-divider-color = #444c56

# Custom shaders (uncomment to enable)
# custom-shader = shaders/gradient-background.glsl
# custom-shader = shaders/cursor-blaze.glsl

# Cursor settings
cursor-style = block
cursor-style-blink = true

# Performance and behavior
shell-integration = zsh
shell-integration-features = cursor,title,sudo
confirm-close-surface = false

# Scrollback
scrollback-limit = 50000
mouse-scroll-multiplier = 3

# Visual enhancements
resize-overlay = always
focus-follows-mouse = false
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true
copy-on-select = false
click-repeat-interval = 300

# Quick terminal
quick-terminal-position = top
quick-terminal-animation-duration = 200
quick-terminal-autohide = true


# Image protocol
image-storage-limit = 320

# URL/Hyperlink handling (cmd+click to open)
link-url = true

# Shift+Enter: let Ghostty send native CSI u
# No explicit keybind needed — Ghostty natively sends CSI u for shift+enter
keybind = shift+enter=unbind

# Fix: Unbind Alt keybinds that conflict with Zellij
# See: https://github.com/ghostty-org/ghostty/discussions/3483
keybind = alt+left=unbind
keybind = alt+right=unbind

# The OS part last, so its values win
config-file = platform
