{
  "providers": {
    "proxy": {
      "baseUrl": "http://localhost:4000/v1",
      "api": "openai-completions",
      "apiKey": "$LITELLM_API_KEY",
      "headers": {
        "User-Agent": "pi"
      },
      "compat": {
        "supportsDeveloperRole": false,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "main",
          "name": "main — DeepSeek Flash (proxy, measured)",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 200000,
          "maxTokens": 16384,
          "compat": {
            "thinkingFormat": "deepseek"
          }
        },
        {
          "id": "deterministic",
          "name": "deterministic — Qwen3.8-27B (Linux model server)",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 65536,
          "maxTokens": 32768,
          "compat": {
            "thinkingFormat": "qwen-chat-template",
            "supportsReasoningEffort": false
          },
          "thinkingLevelMap": {
            "minimal": null,
            "low": null,
            "medium": "medium",
            "high": null,
            "xhigh": null,
            "max": null
          },
          "samplingParams": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20
          }
        },
        {
          "id": "complex",
          "name": "complex — DeepSeek V4 Pro (proxy, measured)",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 200000,
          "maxTokens": 32768,
          "compat": {
            "thinkingFormat": "deepseek"
          }
        }
      ]
    }
  }
}
