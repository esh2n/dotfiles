# op:// references — POINTERS, not secrets. Safe to commit: `op run --env-file
# litellm.op-vars` resolves these to real values and injects them into the
# child process env only; plaintext never touches disk or this file. NEVER put
# a resolved key here.
#
# Resolved by a 1Password SERVICE ACCOUNT (headless, no Touch ID): the wrapper
# reads OP_SERVICE_ACCOUNT_TOKEN from the macOS login Keychain, then `op run`
# authenticates with it. The service account is scoped read-only to the
# `llm-automation` vault only (items: deepseek, litellm — field `credential`).

# Only the high-value provider secret is op-injected. The proxy's master_key is
# a non-secret loopback constant set directly in config.yaml (not here).
DEEPSEEK_API_KEY=op://llm-automation/deepseek/credential

# TypeSafe (Jev) decision model. Same vault-level service-account grant as the
# items above (verified 2026-08-24: `op read` on this pointer resolves through the
# `litellm-op-token` SA). Consumed by the jig judgment service
# (home/shared/services/jig-decision-up.sh), which reads it once at login and
# answers every harnesses' judgments over the loopback — harnesses never see it.
TYPESAFE_API_KEY=op://llm-automation/typesafe/credential

# complex/Astra tier is not wired yet (no OpenAI key on this service account).
# A literal placeholder keeps LiteLLM startup happy; the `complex` route stays
# unused until an openai item is added to llm-automation and referenced here.
OPENAI_API_KEY=unset-placeholder

# The deterministic tier's llama-server (the Omarchy desktop). Its API base
# is http://<the roles file's llamaServerHost>:8080/v1 — a machine fact, so
# it is not here: export LLAMA_SERVER_API_BASE before start.sh.
LLAMA_SERVER_API_KEY=op://llm-automation/llama-server/credential
