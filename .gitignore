**/*secret*.json
# Not a secret itself — a JSON list of the REGEX SHAPES that catch one
# (openai-key, github-token, ...), shared by artifact's scan.mjs and
# the T35 prepush scanner. Re-included so it can actually be tracked.
!harness/skills/artifact/bin/lib/secret-patterns.json
