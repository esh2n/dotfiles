#!/bin/bash
# launchd starts sketchybar with a minimal PATH; ensure nix + user bins are visible
# so that mise (and therefore lua) can be located.
export PATH="/etc/profiles/per-user/$USER/bin:$HOME/.nix-profile/bin:/run/current-system/sw/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# Activate mise to make mise-managed tools (lua) available in launchd context
if command -v mise >/dev/null 2>&1; then
    eval "$(mise env -s bash 2>/dev/null)" || true
fi

cd "$(dirname "$0")"

# SbarLua statically links its own Lua and must be loaded by an interpreter of
# the same major.minor. A mismatch (e.g. 5.4 .so under the mise-global 5.5)
# does not raise an error: the config just exits and the bar stays empty.
# Pick the interpreter that matches the .so; `update` rebuilds the .so against
# the current lua (domains/workspace/install.sh), so this is only a safety net.
SBARLUA_SO="$HOME/.local/share/sketchybar_lua/sketchybar.so"
so_ver="$(grep -a -o 'LuaVersion: Lua [0-9]*\.[0-9]*' "$SBARLUA_SO" 2>/dev/null | head -1 | sed 's/.*Lua //')"
host_ver="$(lua -v 2>&1 | sed -n 's/^Lua \([0-9]*\.[0-9]*\).*/\1/p')"

if [[ -n "$so_ver" && "$so_ver" != "$host_ver" ]]; then
    if command -v mise >/dev/null 2>&1 && mise where "lua@${so_ver}" >/dev/null 2>&1; then
        echo "sketchybarrc: SbarLua is built for Lua ${so_ver}, host lua is ${host_ver}; using lua@${so_ver}" >&2
        exec mise exec "lua@${so_ver}" -- lua -e 'require("helpers"); require("init")'
    fi
    echo "sketchybarrc: SbarLua is built for Lua ${so_ver} but lua is ${host_ver}. Rebuild with: FORCE=true domains/workspace/install.sh" >&2
fi

exec lua -e 'require("helpers"); require("init")'
