#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------------
# Cabinet Launcher
# Cabinet (AI-first knowledge base) 起動ラッパー
# https://github.com/cabinetai/cabinet
#
# Data layout (all outside the dotfiles repo):
#   ~/cabinets/<name>   each cabinet (markdown content, .agents/, .jobs/)
#   ~/.cabinet/         version-pinned app cache, managed by cabinetai itself
# -----------------------------------------------------------------------------

# Load utilities
if [[ -n "${DOTFILES_ROOT:-}" ]]; then
    source "$DOTFILES_ROOT/core/utils/common.sh"
elif [[ -f "$HOME/dotfiles/core/utils/common.sh" ]]; then
    source "$HOME/dotfiles/core/utils/common.sh"
else
    log_info() { echo "[INFO] $1"; }
    log_error() { echo "[ERROR] $1" >&2; }
fi

CABINETS_ROOT="${CABINETS_ROOT:-$HOME/cabinets}"
CABINET_DEFAULT="${CABINET_DEFAULT:-main}"

usage() {
    cat <<EOF
Usage: cabinet [name]              start a cabinet (default: ${CABINET_DEFAULT})
       cabinet create <name>       create a new cabinet under ${CABINETS_ROOT}
       cabinet ls                  list cabinets under ${CABINETS_ROOT}
       cabinet cli [args...]       pass args through to 'npx cabinetai' in the
                                   default cabinet (doctor, import, update, ...)

Env: CABINETS_ROOT (default ~/cabinets), CABINET_DEFAULT (default main),
     CABINET_APP_PORT (default 4000), CABINET_DAEMON_PORT (default 4100)
EOF
}

require_node() {
    if ! command -v npx >/dev/null 2>&1; then
        log_error "npx not found — install Node.js (mise/nix) first"
        exit 1
    fi
}

# 'npx cabinetai run' bootstraps a non-cabinet directory in place, so starting
# a missing cabinet only needs mkdir + run.
start_cabinet() {
    local name="$1"
    local dir="${CABINETS_ROOT}/${name}"
    require_node
    mkdir -p "$dir"
    log_info "Starting cabinet '${name}' (${dir})..."
    cd "$dir"
    exec npx --yes cabinetai run
}

case "${1:-}" in
    -h|--help|help)
        usage
        ;;
    create)
        [[ -n "${2:-}" ]] || { usage; exit 1; }
        require_node
        mkdir -p "$CABINETS_ROOT"
        cd "$CABINETS_ROOT"
        exec npx --yes cabinetai create "$2"
        ;;
    ls|list)
        [[ -d "$CABINETS_ROOT" ]] && ls -1 "$CABINETS_ROOT" || log_info "No cabinets yet (${CABINETS_ROOT})"
        ;;
    cli)
        shift
        require_node
        mkdir -p "${CABINETS_ROOT}/${CABINET_DEFAULT}"
        cd "${CABINETS_ROOT}/${CABINET_DEFAULT}"
        exec npx --yes cabinetai "$@"
        ;;
    "")
        start_cabinet "$CABINET_DEFAULT"
        ;;
    *)
        start_cabinet "$1"
        ;;
esac
