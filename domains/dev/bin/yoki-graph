#!/usr/bin/env node
'use strict';

// Thin node launcher for yoki-graph — executes Workflow-tool-shaped scripts
// outside Claude Code (claude -p / codex exec / omp headless / mock).
// All the actual logic lives in
// domains/dev/config/claude-profiles/runtime/yoki/scripts/lib/graph/cli.js;
// this file only has to find that path reliably regardless of how it was
// invoked — directly, or through the ~/bin symlink the dotfiles linker
// makes from this exact file (same reasoning as yoki-artifact's launcher:
// `fs.realpathSync` resolves the symlink chain back to this file's real
// location, from which the path to lib/graph/cli.js is fixed).

const fs = require('fs');
const path = require('path');

const realFile = fs.realpathSync(process.argv[1]);
const binDir = path.dirname(realFile); // .../domains/dev/bin
const cliPath = path.join(
  binDir, '..', 'config', 'claude-profiles', 'runtime', 'yoki', 'scripts', 'lib', 'graph', 'cli.js',
);

require(cliPath).main();
