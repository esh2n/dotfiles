#!/usr/bin/env bash
set -euo pipefail

# -----------------------------------------------------------------------------
# Claude Code Config Composer (packs edition)
# -----------------------------------------------------------------------------
# Composes ~/.claude from three layers, weakest to strongest:
#   core/     — curated universal defaults (always on)
#   packs/    — optional per-language/domain sets, toggled per machine
#   personal/ — personal skills/hooks/commands/settings; merged LAST so the
#               personal layer always wins name collisions and settings keys
#
# Enabled packs live in ~/.claude/.claude-packs (seeded from packs.default).
# Hook runtime lives under runtime/yoki (originally vendored from
# everything-claude-code, now maintained independently — see runtime/yoki/ORIGIN).
# -----------------------------------------------------------------------------

# The checkout this script physically lives in, resolved through whatever
# symlink it was invoked as (claude-switch, ~/bin/yoki-switch, ...). Prints
# the root, or nothing when the realpath cannot be resolved.
#
# Two callers with different triggers need this same value: the unconditional
# resolution below (only when DOTFILES_ROOT is unset) and --here (which must
# override an already-exported DOTFILES_ROOT). Keeping one implementation is
# the point — the realpath fallback chain and the `../../..` climb both encode
# this file's own location, and a fix applied to one copy silently left the
# other stale.
_yoki_root_from_self() {
    local real
    real="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || python3 -c "import os; print(os.path.realpath('${BASH_SOURCE[0]}'))" 2>/dev/null || echo "")"
    [[ -n "$real" ]] || return 0
    # Script is at $DOTFILES_ROOT/domains/dev/bin/yoki-switch
    # (claude-switch in the same dir is a permanent symlink alias to it)
    (cd "$(dirname "$real")/../../.." 2>/dev/null && pwd) || true
}

# Resolve DOTFILES_ROOT from script's own location (works via symlink)
if [[ -z "${DOTFILES_ROOT:-}" ]]; then
    _self_root="$(_yoki_root_from_self)"
    if [[ -n "$_self_root" ]]; then
        DOTFILES_ROOT="$_self_root"
    fi
fi

# Name this was invoked as (claude-switch or yoki-switch) — used only in
# messages so both names read naturally regardless of which one the caller
# typed. Behavior is identical either way; this is cosmetic only.
PROG="$(basename "${0:-yoki-switch}")"

# --here: use the checkout this script came from, even if it is a worktree.
# Applies to every subcommand (apply, doctor, pack ...): DOTFILES_ROOT is
# re-derived from the script's own realpath and takes precedence over an
# inherited DOTFILES_ROOT — the login shell exports the main checkout's path
# machine-wide, so without this a worktree's `yoki-switch --here doctor`
# would still run the main checkout's runtime/yoki code.
REDIRECTED_FROM=""
declare -a _argv=()
for _a in "$@"; do
    [[ "$_a" == "--here" ]] && { REDIRECTED_FROM="--here"; continue; }
    _argv+=("$_a")
done
set -- "${_argv[@]+"${_argv[@]}"}"

if [[ "$REDIRECTED_FROM" == "--here" ]]; then
    _here_root="$(_yoki_root_from_self)"
    if [[ -n "$_here_root" && -d "${_here_root}/domains/dev/config/claude-profiles" ]]; then
        DOTFILES_ROOT="$_here_root"
    fi
fi

# ~/.claude/settings.json bakes DOTFILES_ROOT into YOKI_ROOT and
# CLAUDE_PLUGIN_ROOT as absolute paths, so applying from a git worktree leaves
# every hook on the machine pointing at a directory that vanishes with the
# worktree. Default to the main checkout; --here opts back in deliberately.
# Silent no-op where there is no git (inside a sandbox DOTFILES_ROOT comes from
# the environment and .git is not mounted).
if [[ "$REDIRECTED_FROM" != "--here" && -n "${DOTFILES_ROOT:-}" ]]; then
    _common="$(git -C "$DOTFILES_ROOT" rev-parse --git-common-dir 2>/dev/null || true)"
    if [[ -n "$_common" ]]; then
        [[ "$_common" == /* ]] || _common="${DOTFILES_ROOT}/${_common}"
        _canonical="$(cd "${_common}/.." 2>/dev/null && pwd || true)"
        if [[ -n "$_canonical" && "$_canonical" != "$DOTFILES_ROOT" \
              && -d "${_canonical}/domains/dev/config/claude-profiles" ]]; then
            REDIRECTED_FROM="$DOTFILES_ROOT"
            DOTFILES_ROOT="$_canonical"
        fi
    fi
fi

# Load utilities (with fallbacks so the script works standalone)
if [[ -n "${DOTFILES_ROOT:-}" && -f "$DOTFILES_ROOT/core/utils/common.sh" ]]; then
    source "$DOTFILES_ROOT/core/utils/common.sh"
elif [[ -f "$HOME/dotfiles/core/utils/common.sh" ]]; then
    source "$HOME/dotfiles/core/utils/common.sh"
fi
type log_info    >/dev/null 2>&1 || log_info()    { echo "[info] $*"; }
type log_success >/dev/null 2>&1 || log_success() { echo "[ok] $*"; }
type log_warn    >/dev/null 2>&1 || log_warn()    { echo "[warn] $*"; }
type log_error   >/dev/null 2>&1 || log_error()   { echo "[error] $*" >&2; }

case "$REDIRECTED_FROM" in
    ""|"--here") ;;
    *)
        log_warn "Invoked from a worktree — applying the main checkout instead."
        log_warn "  worktree: $REDIRECTED_FROM"
        log_warn "  applying: $DOTFILES_ROOT"
        log_warn "Use '${PROG} --here ...' to apply the worktree's own content."
        ;;
esac

# Resolve profiles directory
PROFILES_DIR=""
for candidate in \
    "${DOTFILES_ROOT:-}/domains/dev/config/claude-profiles" \
    "$HOME/dotfiles/domains/dev/config/claude-profiles"; do
    if [[ -d "$candidate" ]]; then
        PROFILES_DIR="$candidate"
        break
    fi
done

if [[ -z "$PROFILES_DIR" ]]; then
    log_error "claude-profiles directory not found"
    exit 1
fi

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
CURSOR_DIR="${CURSOR_DIR:-$HOME/.cursor}"
CODEX_DIR="${CODEX_DIR:-$HOME/.codex}"
OMP_AGENT_DIR="${OMP_AGENT_DIR:-$HOME/.omp/agent}"
PERSONAL_DIR="$PROFILES_DIR/personal"
CORE_DIR="$PROFILES_DIR/core"
PACKS_DIR="$PROFILES_DIR/packs"
RUNTIME_DIR="$PROFILES_DIR/runtime/yoki"
PACKS_FILE="$CLAUDE_DIR/.claude-packs"
PACKS_DEFAULT="$PROFILES_DIR/packs.default"

# Components merged across core + enabled packs + personal (personal wins)
MERGE_DIRS=(skills hooks scripts commands agents rules workflows)

# Dry-run plan mode (`apply --dry-run`, claude target). While this is 1 the
# script must not write a single byte under $CLAUDE_DIR: the claude build runs
# against a throwaway CLAUDE_DIR (see apply_claude_plan) and enabled_packs()
# reads packs.default in place instead of seeding $CLAUDE_DIR/.claude-packs.
PLAN_MODE=0

# -----------------------------------------------------------------------------
# pack helpers
# -----------------------------------------------------------------------------
available_packs() {
    find "$PACKS_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

enabled_packs() {
    if [[ ! -f "$PACKS_FILE" ]]; then
        # dry-run: report the selection a real apply WOULD seed, without
        # creating $CLAUDE_DIR/.claude-packs (or $CLAUDE_DIR itself) here.
        if [[ "$PLAN_MODE" == 1 ]]; then
            if [[ -f "$PACKS_DEFAULT" ]]; then
                grep -vE '^\s*(#|$)' "$PACKS_DEFAULT" 2>/dev/null | sort -u || true
            fi
            return 0
        fi
        if [[ -f "$PACKS_DEFAULT" ]]; then
            mkdir -p "$CLAUDE_DIR"
            cp "$PACKS_DEFAULT" "$PACKS_FILE"
        else
            touch "$PACKS_FILE"
        fi
    fi
    grep -vE '^\s*(#|$)' "$PACKS_FILE" 2>/dev/null | sort -u
}

pack_is_enabled() {
    enabled_packs | grep -qx "$1"
}

save_packs() {
    # $@ = pack names
    mkdir -p "$CLAUDE_DIR"
    printf '%s\n' "$@" | sort -u | grep -vE '^\s*$' > "$PACKS_FILE" || true
}

validate_pack() {
    if [[ ! -d "$PACKS_DIR/$1" ]]; then
        log_error "Unknown pack: $1"
        log_info "Available: $(available_packs | tr '\n' ' ')"
        exit 1
    fi
}

# -----------------------------------------------------------------------------
# merge settings.json (core layer ← enabled packs ← personal → output;
# personal wins, packs win over core, core is the floor)
# -----------------------------------------------------------------------------
# Packs may ship their own settings.layer.json (e.g. packs/go/settings.layer.json)
# to register hooks/permissions/env that only apply when that pack is enabled —
# see README.md "パックの追加" for the contract. Optional: a pack with no
# settings.layer.json is skipped and behaves exactly as before this existed.
merge_settings() {
    local layer="$CORE_DIR/settings.layer.json"
    local personal="$PERSONAL_DIR/settings.personal.json"
    local output="$CLAUDE_DIR/settings.json"
    local -a packs=("$@")
    local tmp
    tmp="$(mktemp)"

    if [[ ! -f "$layer" ]]; then
        log_error "Core settings not found: $layer"
        exit 1
    fi
    if [[ ! -f "$personal" ]]; then
        log_error "Personal settings not found: $personal"
        exit 1
    fi

    local -a pack_layers=()
    local p
    for p in "${packs[@]+"${packs[@]}"}"; do
        [[ -f "$PACKS_DIR/$p/settings.layer.json" ]] && pack_layers+=("$PACKS_DIR/$p/settings.layer.json")
    done

    # -------------------------------------------------------------------
    # Permissions (T8): source of truth is permissions.yaml per layer, not
    # the settings.layer.json/settings.personal.json JSON files above — see
    # core/permissions.yaml and personal/permissions.yaml. A pack may add
    # packs/<name>/permissions.yaml; missing files are treated as an empty
    # layer (lib/permissions/parse.js). to-claude.js loads + dedupes
    # core → enabled packs → personal (union semantics, same precedence as
    # the settings merge below) and prints
    # {settings:{allow,deny,defaultMode}, hookEnforced:[...]} on stdout.
    # -------------------------------------------------------------------
    if ! command -v node >/dev/null 2>&1; then
        log_error "merge_settings requires node (for lib/permissions/to-claude.js) — none found on PATH."
        exit 1
    fi

    local -a perm_sources=("$CORE_DIR/permissions.yaml")
    for p in "${packs[@]+"${packs[@]}"}"; do
        [[ -f "$PACKS_DIR/$p/permissions.yaml" ]] && perm_sources+=("$PACKS_DIR/$p/permissions.yaml")
    done
    perm_sources+=("$PERSONAL_DIR/permissions.yaml")

    local perm_json
    if ! perm_json="$(node "$RUNTIME_DIR/scripts/lib/permissions/to-claude.js" --sources "${perm_sources[@]}")"; then
        log_error "Failed to convert permissions.yaml layers via lib/permissions/to-claude.js"
        exit 1
    fi

    # -------------------------------------------------------------------
    # MCP servers (T13): source of truth is mcp.json per layer, not the
    # settings.layer.json `mcpServers` key above — see core/mcp.json and
    # personal/mcp.json. A pack may add packs/<name>/mcp.json; missing files
    # are treated as an empty layer (lib/mcp-inventory/source.js). The
    # claude.js writer loads + merges core → enabled packs → personal (later
    # layer wins by name, same precedence as everything else here) and
    # prints the settings.json `mcpServers` object on stdout.
    # -------------------------------------------------------------------
    local -a mcp_sources=("$CORE_DIR/mcp.json")
    for p in "${packs[@]+"${packs[@]}"}"; do
        [[ -f "$PACKS_DIR/$p/mcp.json" ]] && mcp_sources+=("$PACKS_DIR/$p/mcp.json")
    done
    mcp_sources+=("$PERSONAL_DIR/mcp.json")

    local mcp_json
    if ! mcp_json="$(node "$RUNTIME_DIR/scripts/lib/mcp-inventory/writers/claude.js" --sources "${mcp_sources[@]}")"; then
        log_error "Failed to convert mcp.json layers via lib/mcp-inventory/writers/claude.js"
        exit 1
    fi

    local dotfiles_parent
    dotfiles_parent="$(dirname "${DOTFILES_ROOT:-$HOME/dotfiles}")"

    # Precedence: personal wins every scalar/object key, packs win over core
    # (core is defaults). permissions.allow/deny come from $perm above
    # (already unioned + deduped across layers by to-claude.js).
    # hooks: personal entries run FIRST — guards (git-guard) must see the
    # original command before any rewriter hooks (rtk-rewrite) touch it.
    # Enabled-pack hooks (e.g. go-guard) run between personal and core.
    # jq -s reads every file argument into one array in argument order:
    # $layer first, $personal last, so .[1:-1] is exactly the pack layers
    # regardless of how many packs contributed a settings.layer.json (zero
    # packs collapses to the original 2-file core+personal behavior).
    jq -s --argjson perm "$perm_json" --argjson mcp "$mcp_json" '
      .[0] as $layer | .[-1] as $personal | (.[1:-1]) as $packs |
      (reduce $packs[] as $p ({}; . * $p)) as $packsMerged |
      ($layer * $packsMerged * $personal) |
      .permissions.allow = $perm.settings.allow |
      .permissions.deny = $perm.settings.deny |
      .permissions.defaultMode = $perm.settings.defaultMode |
      .hooks = (
        ($personal.hooks // {}) as $ph | ($packsMerged.hooks // {}) as $pkh | ($layer.hooks // {}) as $lh |
        ($ph | keys) + ($pkh | keys) + ($lh | keys) | unique |
        map(. as $k | {($k): (($ph[$k] // []) + ($pkh[$k] // []) + ($lh[$k] // []))}) |
        add // {}
      ) |
      .mcpServers = $mcp |
      .enabledPlugins = (($layer.enabledPlugins // {}) + ($packsMerged.enabledPlugins // {}) + ($personal.enabledPlugins // {})) |
      .extraKnownMarketplaces = (
        ($layer.extraKnownMarketplaces // {}) + ($packsMerged.extraKnownMarketplaces // {}) + ($personal.extraKnownMarketplaces // {})
      ) |
      .env = (($layer.env // {}) + ($packsMerged.env // {}) + ($personal.env // {}))
    ' "$layer" "${pack_layers[@]+"${pack_layers[@]}"}" "$personal" \
      | sed "s|{{DOTFILES_PARENT}}|${dotfiles_parent}|g" \
      | sed "s|{{DOTFILES_ROOT}}|${DOTFILES_ROOT:-$HOME/dotfiles}|g" \
      | sed "s|{{HOME}}|${HOME}|g" \
      > "$tmp"

    # pre-permission-guard.js's hook-enforced deny set — written where the
    # hook reads it (<CLAUDE_DIR>/.yoki/permissions.json), independent of
    # settings.json itself.
    mkdir -p "$CLAUDE_DIR/.yoki"
    jq -n --argjson perm "$perm_json" '{deny: $perm.hookEnforced}' > "$CLAUDE_DIR/.yoki/permissions.json"

    # Runtime-owned keys: Claude Code itself writes .autoMode (environment,
    # soft_deny) into settings.json; no layer carries it, so a plain rewrite
    # would drop it on every apply. Carry it over from the previous output.
    if [[ -f "$output" ]] && jq -e '.autoMode' "$output" >/dev/null 2>&1; then
        # Never redirect onto "$output" while jq still reads it: the shell
        # truncates the target first and jq would slurp an empty file.
        jq --slurpfile prev "$output" '. + {autoMode: $prev[0].autoMode}' "$tmp" > "$tmp.merged"
        mv "$tmp.merged" "$output"
        rm -f "$tmp"
    else
        mv "$tmp" "$output"
    fi
}

# -----------------------------------------------------------------------------
# merge CLAUDE.md (core layer first, personal last — specific overrides general)
# -----------------------------------------------------------------------------
merge_claude_md() {
    local layer="$CORE_DIR/CLAUDE.layer.md"
    local personal="$PERSONAL_DIR/CLAUDE.personal.md"
    local output="$CLAUDE_DIR/CLAUDE.md"

    if [[ -f "$layer" && -f "$personal" ]]; then
        cat "$layer" > "$output"
        printf "\n\n" >> "$output"
        cat "$personal" >> "$output"
    elif [[ -f "$personal" ]]; then
        cp "$personal" "$output"
    elif [[ -f "$layer" ]]; then
        cp "$layer" "$output"
    fi
}

# -----------------------------------------------------------------------------
# merge_dir: core/{dir} + packs/<enabled>/{dir} + personal/{dir} → staging
# symlinks. Later sources overwrite same names, so personal always wins.
# -----------------------------------------------------------------------------
merge_dir() {
    local dir_name="$1"; shift
    local packs=("$@")
    local stage="$CLAUDE_DIR/.${dir_name}-merged"
    local link="$CLAUDE_DIR/$dir_name"

    if [[ -d "$stage" ]]; then
        find "$stage" -mindepth 1 -delete
    else
        mkdir -p "$stage"
    fi

    local total=0
    local -a sources=("$CORE_DIR/$dir_name")
    local p
    for p in "${packs[@]+"${packs[@]}"}"; do
        sources+=("$PACKS_DIR/$p/$dir_name")
    done
    sources+=("$PERSONAL_DIR/$dir_name")

    local src item name
    for src in "${sources[@]}"; do
        [[ -d "$src" ]] || continue
        for item in "$src"/*; do
            [[ -e "$item" || -L "$item" ]] || continue
            name="$(basename "$item")"
            ln -sfn "$item" "$stage/$name"
            ((total++)) || true
        done
    done

    if [[ -d "$link" && ! -L "$link" ]]; then
        mv "$link" "$link.backup.$(date +%Y%m%d-%H%M%S)"
    fi
    [[ -L "$link" ]] && rm "$link"
    ln -sfn "$stage" "$link"

    log_success "Merged $dir_name: $total items"
}

# -----------------------------------------------------------------------------
# link_external_resources: apply-time linking for machine/account-specific
# targets declared in external-links.yaml (task T35).
#
# Principle: a git-tracked symlink must be relative and stay inside the
# repository. Anything that needs to point into $HOME or is otherwise
# machine/account specific (e.g. core/commands/prompts used to be a tracked
# symlink to /Users/<account>/.config/prompts/global) is declared in
# core/packs/<name>/personal/external-links.yaml instead and linked here,
# at apply time — never committed as a real symlink.
#
# Parsing/resolution lives in lib/external-links.js (same "tiny YAML subset,
# no dependency" approach as lib/permissions/parse.js); this just resolves
# the layer file list, shells out, and does the actual ln -sfn/skip per
# resolved entry. Must run AFTER the MERGE_DIRS staging loop: a dest like
# "commands/prompts" lands inside a staging dir (.commands-merged) that
# merge_dir() already rebuilt for this apply, and link_external_resources
# only adds to it rather than wiping it.
# -----------------------------------------------------------------------------
link_external_resources() {
    local -a packs=("$@")

    if ! command -v node >/dev/null 2>&1; then
        log_error "link_external_resources requires node (for lib/external-links.js) — none found on PATH."
        exit 1
    fi

    local -a link_sources=("$CORE_DIR/external-links.yaml")
    local p
    for p in "${packs[@]+"${packs[@]}"}"; do
        [[ -f "$PACKS_DIR/$p/external-links.yaml" ]] && link_sources+=("$PACKS_DIR/$p/external-links.yaml")
    done
    link_sources+=("$PERSONAL_DIR/external-links.yaml")

    local links_json
    if ! links_json="$(node "$RUNTIME_DIR/scripts/lib/external-links.js" --sources "${link_sources[@]}" --claude-dir "$CLAUDE_DIR" --home "$HOME")"; then
        log_error "Failed to resolve external-links.yaml layers via lib/external-links.js"
        exit 1
    fi

    local count=0
    local dest src_expanded dest_path
    while IFS=$'\t' read -r dest src_expanded dest_path; do
        [[ -n "$dest" ]] || continue
        if [[ -e "$src_expanded" || -L "$src_expanded" ]]; then
            mkdir -p "$(dirname "$dest_path")"
            ln -sfn "$src_expanded" "$dest_path"
            ((count++)) || true
            # A real apply stays quiet about the entries that just worked;
            # `apply --dry-run` has to name them, since "what would be linked
            # vs skipped" is the whole point of the report.
            if [[ "$PLAN_MODE" == 1 ]]; then
                log_info "external-link: $dest -> $src_expanded — would be linked"
            fi
        else
            log_info "external-link: $dest -> $src_expanded not found on this machine — skipped (see 'yoki-switch doctor')"
        fi
    done < <(printf '%s' "$links_json" | jq -r '.[] | [.dest, .srcExpanded, .destPath] | @tsv')

    log_success "External links: $count linked"
}

# -----------------------------------------------------------------------------
# link_cursor_rules: vendored ECC cursor rules → ~/.cursor/rules
# -----------------------------------------------------------------------------
link_cursor_rules() {
    local src="$RUNTIME_DIR/.cursor/rules"
    [[ -d "$src" ]] || return 0
    mkdir -p "$CURSOR_DIR/rules"
    local rule name count=0
    for rule in "$src"/*; do
        [[ -e "$rule" ]] || continue
        name="$(basename "$rule")"
        ln -sfn "$rule" "$CURSOR_DIR/rules/$name"
        ((count++)) || true
    done
    log_success "Cursor: linked $count rules → ~/.cursor/rules/"
}

# -----------------------------------------------------------------------------
# apply --dry-run, claude target: print the plan, write nothing under
# $CLAUDE_DIR.
#
# Nothing below re-implements the merge. The "would-be" output is produced by
# running the SAME merge_settings / merge_claude_md / merge_dir /
# link_external_resources against a throwaway CLAUDE_DIR under mktemp -d, and
# the report is a diff of those outputs against the ones the real $CLAUDE_DIR
# holds today. So the plan cannot drift from what an apply actually does: if
# the merge changes, the plan changes with it.
#
# The real directory is only ever READ, and only for two things: the diffs,
# and seeding settings.json into the sandbox (merge_settings carries
# .autoMode over from the previous output — without that seed every dry run
# would report a spurious autoMode removal).
# -----------------------------------------------------------------------------
PLAN_SANDBOX=""

plan_cleanup() {
    if [[ -n "$PLAN_SANDBOX" && -d "$PLAN_SANDBOX" ]]; then
        rm -rf "$PLAN_SANDBOX"
    fi
    PLAN_SANDBOX=""
}

# plan_stage_counts <staging dir> — classify the staged symlinks by the layer
# they resolve to. Counts the WINNERS (merge_dir has already applied the
# personal > packs > core overwrite), so the per-layer numbers add up to the
# entry count the staging dir would actually have.
plan_stage_counts() {
    local stage="$1"
    local core=0 pack=0 personal=0 other=0 total=0
    local item target
    for item in "$stage"/*; do
        [[ -e "$item" || -L "$item" ]] || continue
        total=$((total + 1))
        target="$(readlink "$item" 2>/dev/null || true)"
        case "$target" in
            "$PERSONAL_DIR"/*) personal=$((personal + 1)) ;;
            "$PACKS_DIR"/*)    pack=$((pack + 1)) ;;
            "$CORE_DIR"/*)     core=$((core + 1)) ;;
            *)                 other=$((other + 1)) ;;
        esac
    done
    printf 'core %-4d packs %-4d personal %-4d other %-4d => %d entries' \
        "$core" "$pack" "$personal" "$other" "$total"
}

# plan_diff <label> <current file> <planned file> — `diff -u` of what is
# installed now against what an apply would install. A non-empty diff is the
# report, never a failure, so this always returns 0.
plan_diff() {
    local label="$1" current="$2" planned="$3"
    echo ""
    log_info "--- $label ---"

    if [[ ! -f "$planned" ]]; then
        log_warn "  planned output not produced: $planned"
        return 0
    fi

    local current_side="$current"
    [[ -f "$current_side" ]] || current_side="/dev/null"

    if diff -q "$current_side" "$planned" >/dev/null 2>&1; then
        echo "  (no change)"
        return 0
    fi

    diff -u -L "current  $current" -L "planned  $current" "$current_side" "$planned" || true
    return 0
}

apply_claude_plan() {
    local -a packs=("$@")
    local real_claude_dir="$CLAUDE_DIR"
    local real_cursor_dir="$CURSOR_DIR"
    local real_packs_file="$PACKS_FILE"

    PLAN_SANDBOX="$(mktemp -d)"
    # EXIT rather than RETURN: merge_settings and friends `exit 1` on a bad
    # layer, and errexit can end the script mid-build too — both must still
    # take the sandbox with them.
    trap plan_cleanup EXIT

    local sandbox_claude="$PLAN_SANDBOX/claude"
    mkdir -p "$sandbox_claude"

    if [[ -f "$real_claude_dir/settings.json" ]]; then
        cp "$real_claude_dir/settings.json" "$sandbox_claude/settings.json"
    fi
    if [[ -f "$real_packs_file" ]]; then
        cp "$real_packs_file" "$sandbox_claude/.claude-packs"
    fi

    # Everything from here to the restore below writes into the sandbox only.
    CLAUDE_DIR="$sandbox_claude"
    CURSOR_DIR="$PLAN_SANDBOX/cursor"
    PACKS_FILE="$sandbox_claude/.claude-packs"

    merge_settings "${packs[@]+"${packs[@]}"}"
    merge_claude_md

    local dir
    local -a stage_lines=()
    for dir in "${MERGE_DIRS[@]}"; do
        # merge_dir's own "Merged X: N items" line reads like something
        # happened; the report prints the per-layer breakdown instead.
        merge_dir "$dir" "${packs[@]+"${packs[@]}"}" >/dev/null
        stage_lines+=("$(printf '  %-20s %s' \
            ".${dir}-merged" "$(plan_stage_counts "$CLAUDE_DIR/.${dir}-merged")")")
    done

    local ext_out
    if ! ext_out="$(link_external_resources "${packs[@]+"${packs[@]}"}" 2>&1)"; then
        CLAUDE_DIR="$real_claude_dir"
        CURSOR_DIR="$real_cursor_dir"
        PACKS_FILE="$real_packs_file"
        log_error "dry-run: could not resolve external-links.yaml layers"
        printf '%s\n' "$ext_out" | sed 's/^/  /'
        exit 1
    fi

    local planned_settings="$CLAUDE_DIR/settings.json"
    local planned_claude_md="$CLAUDE_DIR/CLAUDE.md"
    local planned_permissions="$CLAUDE_DIR/.yoki/permissions.json"

    CLAUDE_DIR="$real_claude_dir"
    CURSOR_DIR="$real_cursor_dir"
    PACKS_FILE="$real_packs_file"

    log_info "=== ${PROG} apply --dry-run (target: claude) ==="
    log_info "Plan only — nothing is written under $CLAUDE_DIR"
    log_info "Would apply: core + packs(${packs[*]:-none}) + personal"

    echo ""
    log_info "--- staging dirs (each rebuilt from scratch) ---"
    printf '%s\n' "${stage_lines[@]+"${stage_lines[@]}"}"

    plan_diff "settings.json" "$CLAUDE_DIR/settings.json" "$planned_settings"
    plan_diff "CLAUDE.md" "$CLAUDE_DIR/CLAUDE.md" "$planned_claude_md"
    plan_diff ".yoki/permissions.json" "$CLAUDE_DIR/.yoki/permissions.json" "$planned_permissions"

    echo ""
    log_info "--- external links ---"
    printf '%s\n' "$ext_out" | sed 's/^/  /'

    echo ""
    log_info "Rebuilt on apply but not diffed here: $CURSOR_DIR/rules, $CLAUDE_DIR/.claude-profile"
    log_success "Dry run complete — $CLAUDE_DIR untouched."

    plan_cleanup
    trap - EXIT
    return 0
}

# -----------------------------------------------------------------------------
# apply_target_generator: builds the codex/omp targets via the shared
# lib/targets/gen.js generator (task T9/T10), superseding the old
# link_codex_ports() (which only ever ported codex/SKILL.md symlinks —
# codex.js's buildSkillOperations()/decideSkillSymlink() reproduces exactly
# that ~/.codex/skills/<name> symlink, idempotently replacing whatever is
# there, so nothing is lost by removing it here).
#
# Skipped (one info line) when the target's home dir does not exist yet —
# mirrors link_codex_ports()'s old "$CODEX_DIR" guard: a fresh machine that
# has never touched Codex/omp should not get ~/.codex or ~/.omp/agent
# created out of thin air just because `yoki-switch apply` ran.
# -----------------------------------------------------------------------------
apply_target_generator() {
    local target="$1" out_dir="$2" dry_run="$3"; shift 3
    local -a packs=("$@")

    if [[ ! -d "$out_dir" ]]; then
        log_info "${target}: $out_dir does not exist — skipping (not installed on this machine)"
        return 0
    fi

    if ! command -v node >/dev/null 2>&1; then
        log_error "apply --target ${target} requires node (for lib/targets/gen.js) — none found on PATH."
        exit 1
    fi

    local -a sources=("$CORE_DIR")
    local p
    for p in "${packs[@]+"${packs[@]}"}"; do
        sources+=("$PACKS_DIR/$p")
    done
    sources+=("$PERSONAL_DIR")

    local sources_csv
    sources_csv="$(IFS=,; echo "${sources[*]}")"

    local -a gen_args=(--target "$target" --sources "$sources_csv" --out "$out_dir")
    [[ "$dry_run" == 1 ]] && gen_args+=(--dry-run)

    if ! node "$RUNTIME_DIR/scripts/lib/targets/gen.js" "${gen_args[@]}"; then
        log_error "${target}: gen.js failed"
        exit 1
    fi

    if [[ "$dry_run" != 1 ]]; then
        log_success "${target}: applied via lib/targets/gen.js → $out_dir"
    fi
    return 0
}

# Returns 0 iff $1 is present among the remaining args (the resolved
# --target list).
_target_requested() {
    local want="$1"; shift
    local t
    for t in "$@"; do
        [[ "$t" == "$want" ]] && return 0
    done
    return 1
}

# -----------------------------------------------------------------------------
# apply: rebuild the requested target(s) from core + enabled packs + personal.
#   --target claude|codex|omp   Restrict to this target (repeatable). With no
#                               --target at all, every target runs (today's
#                               default: claude + codex + omp).
#   --dry-run                   Print the planned operations, write nothing.
#                               Forwarded to lib/targets/gen.js for the
#                               codex/omp targets; the claude target builds
#                               into a throwaway CLAUDE_DIR and reports the
#                               staging-dir counts plus a diff per generated
#                               file (see apply_claude_plan). Exit status is
#                               0 even when the diffs are non-empty — a diff
#                               is the report, not a failure.
# -----------------------------------------------------------------------------
apply() {
    local -a targets=()
    local dry_run=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --target)
                shift
                [[ $# -ge 1 ]] || { log_error "Usage: ${PROG} apply --target <claude|codex|omp>"; exit 1; }
                case "$1" in
                    claude|codex|omp) targets+=("$1") ;;
                    *) log_error "Unknown --target: $1 (expected claude, codex, or omp)"; exit 1 ;;
                esac
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            *)
                log_error "Usage: ${PROG} apply [--target claude|codex|omp]... [--dry-run]"
                exit 1
                ;;
        esac
    done

    [[ ${#targets[@]} -eq 0 ]] && targets=(claude codex omp)

    # Must be set before enabled_packs() runs below: seeding .claude-packs
    # from packs.default is itself a write under $CLAUDE_DIR.
    [[ "$dry_run" == 1 ]] && PLAN_MODE=1

    local -a packs=()
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        if [[ -d "$PACKS_DIR/$p" ]]; then
            packs+=("$p")
        else
            log_warn "Enabled pack not found, skipping: $p"
        fi
    done < <(enabled_packs)

    if _target_requested claude "${targets[@]}"; then
        if [[ "$dry_run" == 1 ]]; then
            apply_claude_plan "${packs[@]+"${packs[@]}"}"
        else
            log_info "Applying: core + packs(${packs[*]:-none}) + personal"

            merge_settings "${packs[@]+"${packs[@]}"}"
            log_success "Merged settings.json (core + packs + personal, personal wins)"

            merge_claude_md
            log_success "Merged CLAUDE.md (core + personal)"

            local dir
            for dir in "${MERGE_DIRS[@]}"; do
                merge_dir "$dir" "${packs[@]+"${packs[@]}"}"
            done

            link_external_resources "${packs[@]+"${packs[@]}"}"

            link_cursor_rules

            # Legacy marker no longer used; keep it pointing at the new scheme
            echo "packs" > "$CLAUDE_DIR/.claude-profile"

            echo ""
            log_success "Applied. Enabled packs: ${packs[*]:-none}"
            log_info "Restart claude-cli to apply changes"
        fi
    fi

    if _target_requested codex "${targets[@]}"; then
        apply_target_generator codex "$CODEX_DIR" "$dry_run" "${packs[@]+"${packs[@]}"}"
    fi

    if _target_requested omp "${targets[@]}"; then
        apply_target_generator omp "$OMP_AGENT_DIR" "$dry_run" "${packs[@]+"${packs[@]}"}"
    fi
}

# -----------------------------------------------------------------------------
# doctor: health-check the claude/codex/omp/artifact targets (task T14).
# Mostly implemented in Node (lib/doctor.js) — this wrapper just resolves the
# same directories apply() uses and forwards --json.
#
# `doctor --prepush [base]` (task T35) is a different mode entirely: instead
# of reading this machine's ~/.claude/~/.codex/~/.omp state, it scans this
# branch's own diff against `base` (default `main`) for secrets, e-mail
# addresses, hardcoded home paths, and unsafe tracked symlinks before you
# push. Delegates straight to lib/prepush-scan.js.
# -----------------------------------------------------------------------------
doctor() {
    local json_flag=()
    local prepush=0
    local prepush_base="main"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag=(--json); shift ;;
            --prepush)
                prepush=1
                shift
                if [[ $# -gt 0 && "$1" != --* ]]; then
                    prepush_base="$1"
                    shift
                fi
                ;;
            *) log_error "Usage: ${PROG} doctor [--json] [--prepush [base]]"; exit 1 ;;
        esac
    done

    if ! command -v node >/dev/null 2>&1; then
        log_error "doctor requires node (for lib/doctor.js / lib/prepush-scan.js) — none found on PATH."
        exit 1
    fi

    if [[ "$prepush" == 1 ]]; then
        node "$RUNTIME_DIR/scripts/lib/prepush-scan.js" \
            --repo-root "${DOTFILES_ROOT:-$HOME/dotfiles}" \
            --base "$prepush_base" \
            "${json_flag[@]+"${json_flag[@]}"}"
        return $?
    fi

    # --yoki-root pins the runtime being checked to this checkout's copy
    # (doctor.js would otherwise take its own location, which is the same
    # thing, but making it explicit keeps --here's meaning in one place).
    node "$RUNTIME_DIR/scripts/lib/doctor.js" \
        --dotfiles-root "${DOTFILES_ROOT:-$HOME/dotfiles}" \
        --yoki-root "$RUNTIME_DIR" \
        --claude-dir "$CLAUDE_DIR" \
        --codex-dir "$CODEX_DIR" \
        --omp-dir "$OMP_AGENT_DIR" \
        "${json_flag[@]+"${json_flag[@]}"}"
}

# -----------------------------------------------------------------------------
# interactive pack picker (no external dependencies)
# -----------------------------------------------------------------------------
interactive() {
    local -a all=() state=()
    local p i
    while IFS= read -r p; do all+=("$p"); done < <(available_packs)

    for i in "${!all[@]}"; do
        if pack_is_enabled "${all[$i]}"; then state[$i]=1; else state[$i]=0; fi
    done

    while true; do
        echo ""
        echo "Packs (toggle by number, 'a' = apply, 'q' = quit without applying):"
        for i in "${!all[@]}"; do
            local mark="[ ]"
            [[ "${state[$i]}" == 1 ]] && mark="[x]"
            printf "  %2d. %s %s\n" "$((i + 1))" "$mark" "${all[$i]}"
        done
        printf "> "
        local input
        read -r input || { echo ""; return 1; }
        case "$input" in
            a|A)
                local -a chosen=()
                for i in "${!all[@]}"; do
                    [[ "${state[$i]}" == 1 ]] && chosen+=("${all[$i]}")
                done
                save_packs "${chosen[@]+"${chosen[@]}"}"
                apply
                return 0
                ;;
            q|Q)
                log_info "Aborted (no changes)"
                return 0
                ;;
            *)
                local n
                for n in $input; do
                    if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#all[@]} )); then
                        i=$((n - 1))
                        state[$i]=$((1 - state[$i]))
                    else
                        log_warn "Invalid selection: $n"
                    fi
                done
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# status output
# -----------------------------------------------------------------------------
show_status() {
    echo "Enabled packs:"
    local p
    while IFS= read -r p; do
        [[ -n "$p" ]] && echo "  * $p"
    done < <(enabled_packs)
    echo ""
    echo "Available packs:"
    while IFS= read -r p; do
        if pack_is_enabled "$p"; then
            echo "  [x] $p"
        else
            echo "  [ ] $p"
        fi
    done < <(available_packs)
    if [[ -f "$RUNTIME_DIR/ORIGIN" ]]; then
        echo ""
        echo "Runtime (yoki):"
        sed 's/^/  /' "$RUNTIME_DIR/ORIGIN"
    fi
}

# -----------------------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------------------
case "${1:-}" in
    "")
        interactive
        ;;
    apply)
        shift
        apply "$@"
        ;;
    doctor)
        shift
        doctor "$@"
        ;;
    pack)
        case "${2:-}" in
            list|"")
                show_status
                ;;
            enable)
                shift 2
                [[ $# -ge 1 ]] || { log_error "Usage: ${PROG} pack enable <pack>..."; exit 1; }
                for p in "$@"; do validate_pack "$p"; done
                declare -a current=()
                while IFS= read -r c; do [[ -n "$c" ]] && current+=("$c"); done < <(enabled_packs)
                save_packs "${current[@]+"${current[@]}"}" "$@"
                apply
                ;;
            disable)
                shift 2
                [[ $# -ge 1 ]] || { log_error "Usage: ${PROG} pack disable <pack>..."; exit 1; }
                declare -a current=()
                while IFS= read -r c; do [[ -n "$c" ]] && current+=("$c"); done < <(enabled_packs)
                declare -a kept=()
                for c in "${current[@]+"${current[@]}"}"; do
                    keep=1
                    for p in "$@"; do [[ "$c" == "$p" ]] && keep=0; done
                    [[ $keep == 1 ]] && kept+=("$c")
                done
                save_packs "${kept[@]+"${kept[@]}"}"
                apply
                ;;
            *)
                log_error "Usage: ${PROG} pack {list|enable|disable} [pack...]"
                exit 1
                ;;
        esac
        ;;
    current|list|status)
        show_status
        ;;
    ecc-sync)
        log_warn "ecc-sync is retired — runtime/yoki is maintained independently (upstream detached)."
        exit 1
        ;;
    ecc|custom)
        log_warn "Profiles are gone — config is now core + packs + personal."
        log_warn "Use '${PROG} pack list' to see packs. Applying current selection..."
        apply
        ;;
    *)
        echo "Usage: ${PROG} [command]"
        echo ""
        echo "  (no args)                     Interactive pack selection, then apply"
        echo "  apply [--target T]... [--dry-run]"
        echo "                                Rebuild target(s) from core + enabled packs + personal."
        echo "                                T is one of: claude codex omp. Repeat --target to pick"
        echo "                                several; with none given, all three run. --dry-run"
        echo "                                prints the plan and writes nothing: staging-dir counts"
        echo "                                per layer plus a diff of settings.json / CLAUDE.md /"
        echo "                                .yoki/permissions.json and the external links for the"
        echo "                                claude target, and lib/targets/gen.js's planned"
        echo "                                operations for codex/omp."
        echo "  doctor [--json]               Health-check claude/codex/omp/artifact targets;"
        echo "                                one line per check, exit 1 iff any check fails."
        echo "  doctor --prepush [base]       Scan this branch's diff against 'base' (default"
        echo "                                main) for secrets/e-mails/home-paths/unsafe symlinks"
        echo "                                before pushing; exit 1 on any hit."
        echo "  pack list                     Show enabled/available packs"
        echo "  pack enable <pack>...         Enable pack(s) and apply"
        echo "  pack disable <pack>...        Disable pack(s) and apply"
        echo "  status                        Same as 'pack list'"
        echo ""
        echo "Layers: core (universal) + packs (per language/domain) + personal (highest precedence, always on)"
        echo "Enabled packs: ~/.claude/.claude-packs (defaults: packs.default)"
        echo "Also invokable as: claude-switch (permanent alias, same script)"
        exit 1
        ;;
esac
