schemaVersion: "2"
kind: sandbox
name: yoki-pi
displayName: pi (LiteLLM-routed, jig-guarded)
description: >-
  pi inside a Docker Sandboxes microVM, talking to the host's LiteLLM proxy
  through the sandbox egress proxy, with jig's guard extension and audit log
  wired exactly as on the host. Forked from docker/sbx-kits-contrib/pi
  (2026-09-21): same pre-baked image, different credentials and network.

# Rendered by yoki-box at launch into a temp dir (see the claude kit's
# spec.yaml.in for why: {{DOTFILES_ROOT}} is one checkout's literal path and
# the sandbox mounts the repo at that same host path). The `.in` suffix keeps
# the template renderer from generating it.
#
# Why a `kind: sandbox` kit and not a mixin on `shell`: the contrib image
# docker.io/sbx/pi-image has pi and Node 22.22.1 baked in and is rebuilt
# nightly, so creating a sandbox does not wait on an npm install. The contrib
# kit itself is wired for api.anthropic.com; this fork points everything at
# the host's LiteLLM instead, which is where this machine's model calls and
# cost measurement go (design-v2 §5.1, D-19).
#
# Verified on this machine 2026-09-21 (sbx 0.43.0): inside the sandbox
# `host.docker.internal:4000` reaches the host's LiteLLM once
# `localhost:4000` is allowed, and a proxy-managed bearer declared for
# `localhost:4000` is swapped for the real key on egress while the VM only
# ever sees the sentinel `proxy-managed`.
sandbox:
  image: docker.io/sbx/pi-image:latest
  entrypoint:
    - pi
agentInstructions:
  filename: AGENTS.md
permissions:
  network:
    allow:
      # The host's LiteLLM proxy (models) and jig's judgment service (tier,
      # skill and compaction judgments). The sandbox proxy rewrites
      # host.docker.internal to localhost before matching, so the rules name
      # localhost. A credential's inject domains are not allowed implicitly.
      - localhost:4000
      - localhost:4100
      # pi's runtime package installs (extensions, skills, prompt templates).
      - registry.npmjs.org
credentials:
  # LiteLLM's master key. pi's models.json reads it from $LITELLM_API_KEY and
  # sends it as `Authorization: Bearer`; the VM holds only the sentinel.
  - service: litellm
    apiKey:
      name: LITELLM_API_KEY
      proxyManaged: true
      inject:
        - domain: localhost:4000
          scheme: bearer
  # jig's judgment service token. The host keeps it in
  # ~/Library/Application Support/jig/decision.token; the sandbox gets it
  # through the same swap, read by the extensions from
  # JIG_DECISION_TOKEN_FILE (written below with the sentinel).
  - service: jig-decision
    apiKey:
      name: JIG_DECISION_TOKEN
      proxyManaged: true
      inject:
        - domain: localhost:4100
          scheme: bearer
environment:
  variables:
    # Host services, as seen from inside the sandbox.
    JIG_DECISION_URL: http://host.docker.internal:4100
    # The shared policy and the audit log live on the host: the policy is on
    # the read-only dotfiles mount, the audit directory is mounted read-write
    # at its own host path by yoki-box, so audit lines land on the host live.
    JIG_POLICY_FILE: "{{DOTFILES_ROOT}}/domains/dev/llm/harness/policy/guard-rules.json"
    JIG_STATE_DIR: "{{HOME}}/.local/state/jig"
    JIG_DECISION_TOKEN_FILE: /home/agent/.config/jig/decision.token
    JIG_HOOK_PROFILE: standard
setup:
  install:
    - command: 'if [ -n "${HTTP_PROXY:-}" ]; then npm config set proxy="$HTTP_PROXY" https-proxy="${HTTPS_PROXY:-$HTTP_PROXY}"; fi'
      user: "1000"
      description: Point npm at the sandbox proxy so pi's runtime npm use works in exec contexts
  startup:
    # pi's config, extensions and AGENTS.md: the same symlinks the host has,
    # made by link-harness.sh against the mounted checkout.
    - command:
        - bash
        - -lc
        - "bash \"{{DOTFILES_ROOT}}/domains/dev/config/sbx/kits/agents/link-harness.sh\" pi \"{{DOTFILES_ROOT}}\""
      user: "1000"
      description: Link pi's settings, models, AGENTS.md and extensions from the dotfiles checkout
    # models.json must name the host as the sandbox sees it. The host file is
    # linked by the step above; this replaces the link with a rewritten copy.
    - command:
        - bash
        - -lc
        - "mkdir -p ~/.pi/agent && sed \"s#http://localhost:4000#http://host.docker.internal:4000#g\" \"{{DOTFILES_ROOT}}/domains/dev/config/pi/models.json\" > ~/.pi/agent/models.json.sbx && rm -f ~/.pi/agent/models.json && mv ~/.pi/agent/models.json.sbx ~/.pi/agent/models.json"
      user: "1000"
      description: Point pi's LiteLLM provider at host.docker.internal
    # The judgment-service token file the extensions read; its content is the
    # sentinel, which the egress proxy swaps on the way to localhost:4100.
    - command:
        - bash
        - -lc
        - "mkdir -p ~/.config/jig && umask 077 && printf \"%s\" \"${JIG_DECISION_TOKEN:-proxy-managed}\" > ~/.config/jig/decision.token"
      user: "1000"
      description: Write the judgment-service token sentinel where the extensions look
    # Drop the host's `packages` list: those are TUI/viewer extensions
    # (pi-vcc, pi-btw, @plannotator/...) that a headless `pi -p` does not use,
    # and some build native modules (node-pty) the shell image cannot compile.
    # The guard and router extensions load from the linked extensions/ dir, not
    # from packages, so they are kept. Replace the settings.json symlink with a
    # trimmed copy, same technique as models.json above.
    - command:
        - bash
        - -lc
        - "node -e 'const fs=require(\"fs\"),p=process.env.HOME+\"/.pi/agent/settings.json\",s=JSON.parse(fs.readFileSync(\"{{DOTFILES_ROOT}}/domains/dev/config/pi/settings.json\",\"utf8\"));delete s.packages;fs.rmSync(p,{force:true});fs.writeFileSync(p,JSON.stringify(s,null,2))'"
      user: "1000"
      description: Drop host TUI extension packages a headless sandbox does not need

