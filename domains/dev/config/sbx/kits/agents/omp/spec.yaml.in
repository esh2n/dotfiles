schemaVersion: "2"
kind: mixin
name: yoki-omp
displayName: yoki harness for omp
description: >-
  Installs omp (oh-my-pi) and wires it to the dotfiles: ~/.omp/agent from the
  omp config plus the jig generator (agents, mcp.json, the jig.ts guard extension).

# Generated from spec.yaml.in by yoki-box at launch — never installed as a file,
# because {{DOTFILES_ROOT}} is a literal path belonging to one checkout.
#
# WHY THIS KIT EXISTS
#
# omp defaults to approvalMode: yolo (every tool auto-approved) and
# auto-executes repo-local .omp/ extensions at session start — both are stated
# design positions, not gaps (upstream issue #8678 closed as by-design). jig's
# omp extension (extensions/jig.ts) carries the guard rules across, but the
# layer that stands between an agent and `rm -rf` does NOT exist on the omp
# side, and a repo-local extension runs before any guard can see it. So: omp
# needs the VM MORE than Claude Code does, not less.

permissions:
  network:
    allow:
      # apt on arm64 Ubuntu resolves to ports.ubuntu.com, not archive.
      - ports.ubuntu.com
      - archive.ubuntu.com
      - security.ubuntu.com
      # omp installs via the official installer script (prebuilt binary with
      # the Bun runtime embedded; no Node/Bun prerequisite in the VM).
      - omp.sh
      - github.com
      - objects.githubusercontent.com
      - release-assets.githubusercontent.com
      # mise for toolchains, same as the other agent kits.
      - mise.run
      - mise.jdx.dev

setup:
  install:
    - command: apt-get update && apt-get install -y zsh fd-find
      description: Base-image gaps besides mise (fd ships as fd-find on Ubuntu)
    - command: curl -fsSL https://mise.run | sh
      user: "1000"
      description: Install mise as the agent user so toolchains land in /home/agent
    - command: curl -fsSL https://omp.sh/install | sh
      user: "1000"
      description: omp itself (prebuilt binary into the agent user's PATH)
    # jig is a bun program; omp's embedded Bun is not on PATH, and the base
    # image has node 22 and npm but no bun. Same three steps `jig box`
    # generates (jig/src/app/box/kit.ts bunSteps).
    - command: npm install -g bun
      description: bun for the jig generator and the jig.ts guard extension
    - command: ln -sf "$(npm prefix -g)/bin/bun" /usr/local/bin/bun
      description: Put bun on the bare PATH omp's extension host gets
    - command: cd {{DOTFILES_ROOT}}/domains/dev/llm/harness/jig && bun install --frozen-lockfile
      user: "1000"
      description: Resolve jig's dependencies once, before the first apply

  startup:
    # The guard policy jig's omp extension reads (JIG_POLICY_FILE, else
    # ~/.config/jig/policy/guard-rules.json) — the same link home-manager
    # makes on the host (next/home/shared/harness). Without it the extension stands
    # down and omp has no guardrails. `$HOME`, not `{{HOME}}`: this must
    # resolve to the SANDBOX user's home (/home/agent) at runtime, not the
    # host's — render_kit's `{{HOME}}` substitution bakes in the host's own
    # $HOME instead, which would be wrong here.
    - command:
        - sh
        - -c
        - mkdir -p "$HOME/.config/jig" && ln -sfn "{{DOTFILES_ROOT}}/domains/dev/llm/harness/policy" "$HOME/.config/jig/policy"
      user: "1000"
      description: Link jig's shared guard policy (what extensions/jig.ts reads its rules from)

    # models.yml/lsp.yml are plain repo files jig never touches (no generator
    # equivalent) — link them directly, as link_omp_resources does on the
    # host; the jig apply below is that function's other half.
    - command:
        - sh
        - -c
        - mkdir -p "$HOME/.omp/agent" && for f in models.yml lsp.yml; do [ -f "{{DOTFILES_ROOT}}/domains/dev/config/omp/$f" ] && ln -sfn "{{DOTFILES_ROOT}}/domains/dev/config/omp/$f" "$HOME/.omp/agent/$f"; done
      user: "1000"
      description: Ensure ~/.omp/agent exists and link models.yml/lsp.yml (no generator equivalent)

    # Delivers ~/.omp/agent's agents/*.md, jig's entries in mcp.json, the
    # ~/.agents/skills mount and extensions/jig.ts (jig README §Milestone
    # 3b); config.yml is omp's own and is left alone.
    - command:
        - sh
        - -c
        - bash {{DOTFILES_ROOT}}/domains/dev/bin/jig apply --target omp --write
      user: "1000"
      description: Deliver ~/.omp/agent with the jig generator

    # NOT DONE HERE: authentication. omp uses subscription OAuth / API keys and
    # the credential store (~/.omp/agent/agent.db) is host runtime state,
    # deliberately not mounted. A fresh sandbox needs `omp` + /login.
