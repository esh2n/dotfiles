schemaVersion: "2"
kind: mixin
name: yoki-claude
requires:
  agent: claude
displayName: yoki harness for Claude Code
description: >-
  Fills the gaps in the sandbox base image and rebuilds ~/.claude from the
  dotfiles layers, so a sandboxed session runs the same hooks, skills, rules
  and workflows as the host.

# Rendered by yoki-box at launch, into a temp dir, and never installed as a
# file. {{DOTFILES_ROOT}} has to be a literal path because a sandbox mounts the
# repo at its HOST path (verified: the mount lands on /Users/... inside the VM,
# via virtiofs, read-only) — and a literal path belongs to one checkout, so a
# generated artifact would be wrong the moment yoki-box runs from a worktree.
# Rendering at launch means the kit always matches the caller. The `.in`
# suffix (not `.template`) keeps core/config/manager.sh from generating it.
#
# Measured on the base image 2026-08-15 (Ubuntu 26.04, user `agent`,
# home /home/agent): node v22.22.1, git 2.53, jq, python3, rg, bash, npm/npx,
# curl are all PRESENT. Only zsh, mise and fd are missing — that is the whole
# install list. In particular node is preinstalled, so the nine core hooks
# that shell out to run-with-flags.js work without any extra provisioning.

permissions:
  network:
    allow:
      # apt on arm64 Ubuntu resolves to ports.ubuntu.com, not archive.
      - ports.ubuntu.com
      - archive.ubuntu.com
      - security.ubuntu.com
      # `curl https://mise.run | sh` redirects mise.run -> mise.jdx.dev, and
      # the installer then pulls the binary from the GitHub release assets.
      # Allowing only mise.run is not enough — the policy log showed the
      # request to mise.jdx.dev hitting default-deny and curl exiting 22.
      - mise.run
      - mise.jdx.dev
      - github.com
      - objects.githubusercontent.com
      - release-assets.githubusercontent.com

setup:
  install:
    - command: apt-get update && apt-get install -y zsh fd-find bubblewrap socat
      description: >-
        Base-image gaps besides mise (fd ships as fd-find on Ubuntu), plus
        bubblewrap and socat, which Claude Code's own Bash sandbox needs on
        Linux — the second layer under the microVM boundary (see startup)
    - command: curl -fsSL https://mise.run | sh
      user: "1000"
      description: Install mise as the agent user so toolchains land in /home/agent

  startup:
    # yoki-switch is fully portable — CLAUDE_DIR and DOTFILES_ROOT are both
    # overridable and it contains no uname checks — so it rebuilds ~/.claude
    # here exactly as it does on the host. Verified end to end 2026-08-15.
    - command:
        - sh
        - -c
        - DOTFILES_ROOT={{DOTFILES_ROOT}} bash {{DOTFILES_ROOT}}/domains/dev/bin/yoki-switch apply
      user: "1000"
      description: Rebuild ~/.claude from core + packs + personal
    # Second layer: turn Claude Code's OWN Bash sandbox on inside the VM. The
    # microVM is the boundary; this is defense-in-depth under it, the same
    # layering Anthropic's sandbox docs recommend. Inside the VM the mechanism
    # is bubblewrap (installed above). Verified 2026-09-22 on sbx v0.43.0:
    # bwrap 0.11.1 runs unprivileged as `agent` (userns enabled), and TLS
    # through the VM's mitm proxy verifies under bwrap (curl 200, verify=0),
    # so Claude Code's sandbox has what it needs here. Fail closed if
    # bubblewrap is missing rather than silently running unsandboxed. The
    # network allowlist mirrors this kit's own `permissions.network.allow`
    # above so the two layers agree instead of one silently blocking what the
    # other permits.
    #
    # Two things found while verifying, both outside this kit's control and
    # both inputs to the `jig box` replacement for yoki-box:
    #   1. `sbx create --clone` plus read-only mounts of subdirectories of the
    #      same repo path (what yoki-box's guarded/connected modes do) hangs
    #      the startup phase indefinitely on v0.43.0 — bisected: the same
    #      kits and mounts finish in under a minute without --clone, and
    #      --clone alone finishes too. Do not layer sub-mounts over a clone.
    #   2. sbx now mounts its own agent-skills dir read-only at
    #      ~/.claude/skills, so `yoki-switch apply` above fails at the point
    #      where it swaps that dir for a symlink ("Device or resource busy"),
    #      and the dispatcher stops there — this python3 step then never
    #      runs. The settings it writes were verified by running it by hand.
    - command:
        - python3
        - -c
        - |
          import json, os
          p = os.path.expanduser("~/.claude/settings.json")
          s = json.load(open(p)) if os.path.exists(p) else {}
          s["sandbox"] = {
            "enabled": True,
            "failIfUnavailable": True,
            "allowUnsandboxedCommands": False,
            "network": {
              "allowedDomains": [
                "ports.ubuntu.com", "archive.ubuntu.com", "security.ubuntu.com",
                "mise.run", "mise.jdx.dev",
                "github.com", "objects.githubusercontent.com",
                "release-assets.githubusercontent.com",
              ],
            },
          }
          json.dump(s, open(p, "w"), indent=2)
          print("sandbox enabled inside VM")
      user: "1000"
      description: Enable Claude Code's own sandbox (bubblewrap) inside the VM, fail-closed
    # Packs are NOT enabled here. They default to OFF on a fresh machine and a
    # sandbox is a fresh machine every time, so without them the sandbox runs
    # with fewer rules and agents than the host (measured: rules 6 -> 2,
    # agents 14 -> 9). But the enabled set is a machine-local choice — it lives
    # in ~/.claude/.claude-packs, not in the repo (packs.default is empty), and
    # there are 23 packs to choose from. Hardcoding a list here would go stale
    # the first time a pack is added. yoki-box reads the host's .claude-packs
    # and enables exactly that set after the sandbox is created.
