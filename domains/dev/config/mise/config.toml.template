[tools]
python = "3.12"
ruby = "latest"
node = "22"
go = "latest"
rust = "latest"
bun = "latest"
deno = "latest"
"vfox:mise-plugins/vfox-flutter" = "latest"
lua = "5.5"

[settings]
experimental = false
verbose = false
env_shell_expand = true
ruby.compile = false

[env]
PYTHONPATH = "{{ env.PYTHONPATH | default(value='') }}:{{ cwd }}"
GEM_HOME = "{{HOME}}/.gem"
GOPATH = "{{HOME}}/go"
GOBIN = "{{HOME}}/go/bin"
CARGO_HOME = "{{HOME}}/.cargo"
RUSTUP_HOME = "{{HOME}}/.rustup"
DENO_INSTALL_ROOT = "{{HOME}}/.deno"
BUN_INSTALL = "{{HOME}}/.bun"
