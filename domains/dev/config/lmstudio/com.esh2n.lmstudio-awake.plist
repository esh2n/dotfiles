<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Source template: the placeholder tokens below are expanded into a real
     copy at ~/Library/LaunchAgents/com.esh2n.lmstudio-awake.plist by
     `make link` (core/config/manager.sh link_launch_agents, via
     install_expanded) — launchd itself never expands env vars or ~, so do not
     hand-edit the deployed copy; fix this source and re-apply. Load once with:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.esh2n.lmstudio-awake.plist
     Keeps the Mac awake exactly while the LM Studio server is running: the
     wrapper waits for a listener on 127.0.0.1:1234 and then becomes
     `caffeinate -s -w <pid>` (see awake.sh). caffeinate exits with the server,
     launchd (KeepAlive) relaunches the wrapper, and it waits again — the
     assertion is never held longer than the server lives. Starting the server
     itself is NOT this job's business: LM Studio's own "run the LLM server on
     login" setting does that (see README.md). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.esh2n.lmstudio-awake</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{HOME}}/.config/lmstudio/awake.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- caffeinate exits cleanly whenever the server stops; the wrapper's own
       30 s poll does the waiting, so a short relaunch delay is enough. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/lmstudio-awake.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/lmstudio-awake.log</string>
</dict>
</plist>
