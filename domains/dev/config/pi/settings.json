{
  "packages": [
    "git:github.com/nicobailon/pi-subagents",
    "npm:pi-web-access",
    "npm:@ogulcancelik/pi-session-recall",
    "npm:@ff-labs/pi-fff",
    "npm:pi-lens",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@plannotator/pi-extension",
    "git:github.com/earendil-works/pi-review",
    "npm:pi-context-view",
    "npm:@sting8k/pi-vcc",
    "npm:@howaboua/pi-codex-conversion",
    "npm:pi-btw",
    "npm:pi-codex-image-gen",
    "git:github.com/earendil-works/pi-transcribe"
  ],
  "lastChangelogVersion": "0.83.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna:low"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra:medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra:medium"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-terra:medium"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol:high"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol:high"
      }
    }
  }
}
