{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOKI_NODE:-node}\" ~/.claude/hooks/go-guard-post-edit.js",
            "timeout": 40
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOKI_NODE:-node}\" ~/.claude/hooks/go-guard-race.js",
            "timeout": 130
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOKI_NODE:-node}\" ~/.claude/hooks/go-version-check.js",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
