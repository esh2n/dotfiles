{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${YOKI_NODE:-node}\" ~/.claude/hooks/py-lint-post-edit.js",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
