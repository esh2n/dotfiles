# Every role a machine may take, named for who the machine is to the rest of
# the home (rules/decisions/2026-09-25-roles-named-as-people.md). A role is a
# name for a set of capabilities, like a role in a web app's permissions: what
# each one grants lives in roles/<name>.nix, and features check the capability
# they are given, never the role. base is not listed: every machine is base.
[
  "developer"
  "desk-user"
  "model-provider"
  "observer"
]
