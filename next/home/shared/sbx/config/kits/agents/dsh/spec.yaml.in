schemaVersion: "2"
kind: sandbox
name: yoki-dsh
displayName: DeepSeek Harness (LiteLLM-routed, jig-guarded)
description: >-
  DeepSeek Harness (dsh) inside a Docker Sandboxes microVM, talking to the
  host's LiteLLM proxy through the sandbox egress proxy, with jig's guard
  plugin and audit log wired as on the host. No contrib kit exists for dsh,
  so this installs it from npm onto the shell-docker base at create time.

# Rendered by yoki-box at launch (see the pi kit for why the `.in` suffix and
# {{DOTFILES_ROOT}} literal-path substitution are needed). Design D-19.
#
# There is no pre-baked dsh image the way there is for pi, so this uses the
# generic shell-docker template (Node 22.22.1, which satisfies dsh's
# ^22.19 || >=24) and npm-installs dsh in setup.install. dsh is a one-shot
# headless CLI, so the entrypoint is a login shell and the actual run is
# `sbx exec <name> -- dsh --profile headless "<task>"`.
sandbox:
  image: docker.io/docker/sandbox-templates:shell-docker
  entrypoint:
    - bash
    - -l
permissions:
  network:
    allow:
      - localhost:4000
      - localhost:4100
      - registry.npmjs.org
credentials:
  - service: litellm
    apiKey:
      name: LITELLM_API_KEY
      proxyManaged: true
      inject:
        - domain: localhost:4000
          scheme: bearer
  - service: jig-decision
    apiKey:
      name: JIG_DECISION_TOKEN
      proxyManaged: true
      inject:
        - domain: localhost:4100
          scheme: bearer
environment:
  variables:
    JIG_DECISION_URL: http://host.docker.internal:4100
    JIG_POLICY_FILE: "{{DOTFILES_ROOT}}/harness/policy/guard-rules.json"
    JIG_STATE_DIR: "{{HOME}}/.local/state/jig"
    JIG_DECISION_TOKEN_FILE: /home/agent/.config/jig/decision.token
    JIG_HOOK_PROFILE: standard
    # dsh reads its LiteLLM key from this name (see dsh.op-vars on the host).
    DSH_HOME: /home/agent/.dsh
setup:
  install:
    - command: 'if [ -n "${HTTP_PROXY:-}" ]; then npm config set proxy="$HTTP_PROXY" https-proxy="${HTTPS_PROXY:-$HTTP_PROXY}"; fi'
      user: "1000"
      description: Point npm at the sandbox proxy
    - command: 'npm install -g @deepseek-ai/dsh@0.1.5-rc.2'
      user: "1000"
      description: Install dsh (no contrib image exists; the shell base ships Node 22.22.1)
  startup:
    # dsh's profile tree and the jig-guard plugin, linked from the checkout by
    # link-harness.sh, which does what harness-apply does on the host: builds the
    # plugin (bun) and pnpm-links it into each profile.
    - command:
        - bash
        - -lc
        - "bash \"{{DOTFILES_ROOT}}/next/home/shared/sbx/config/kits/agents/link-harness.sh\" dsh \"{{DOTFILES_ROOT}}\""
      user: "1000"
      description: Install dsh profiles and build/link jig-guard from the dotfiles checkout
    # dsh's LiteLLM provider must name the host as the sandbox sees it. The
    # host's settings.yaml points at localhost:4000; rewrite the deployed copy.
    - command:
        - bash
        - -lc
        - "if [ -f ~/.dsh/settings.yaml ]; then sed -i \"s#http://localhost:4000#http://host.docker.internal:4000#g\" ~/.dsh/settings.yaml; fi"
      user: "1000"
      description: Point dsh's LiteLLM provider at host.docker.internal
    - command:
        - bash
        - -lc
        - "mkdir -p ~/.config/jig && umask 077 && printf \"%s\" \"${JIG_DECISION_TOKEN:-proxy-managed}\" > ~/.config/jig/decision.token"
      user: "1000"
      description: Write the judgment-service token sentinel
    - command:
        - bash
        - -lc
        - "printf \"%s\" \"${LITELLM_API_KEY:-proxy-managed}\" > /dev/null"
      user: "1000"
      description: Touch the LiteLLM sentinel so a missing binding fails loudly at create, not mid-run
