# Seed for ~/.codex/config.toml, copied ONCE by domains/dev/install.sh's
# ensure_codex_config when the live file does not exist yet. It is never
# re-applied: the live file carries jig's managed `[mcp_servers.*]` block and
# codex's own hook trust hashes, which a second copy would discard.
#
# Keep only settings that are genuinely machine-local starting points here.
# Anything jig owns belongs in harness instead, delivered by
# `make link` (`jig apply --target codex --write` + `jig codex register --write`):
#   - MCP servers        -> llm/harness/mcp/servers.json
#   - the guard hook     -> hooks.json, registered by `jig codex register`
#   - AGENTS.md / agents -> llm/harness/rules, llm/harness/agents
# jig refuses to manage an `[mcp_servers.<name>]` it finds declared outside
# its block ("left alone, reported"), so a server listed both here and in
# servers.json silently stops following the canonical inventory.

hide_agent_reasoning = true
network_access = true
model = "gpt-5-codex"

# Stage-1 native sandbox (design-v2 §5, D-19). The shell tool runs under
# Seatbelt with write confined to the workspace; codex's own model calls (the
# LiteLLM proxy) are outside this boundary, so they are unaffected. Network
# for the shell is off by default — a shell command that needs the network is
# denied rather than allowed silently. codex forbids `sandbox_mode` together
# with `default_permissions`, so this replaces yoki's `[permissions.yoki]`
# block: the same denies (~/.aws, ~/.ssh, ...) are enforced by jig's
# registered hook and its v2 policy, so protection moves to jig, not away.
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = false

[tools]
web_search = true

# Codex-only servers, absent from the canonical mcp.json inventory. figma
# reads a key from the environment rather than a literal (mcp.json rejects
# literal secrets outright, which is why this entry never moved there).
[mcp_servers.figma]
command = "npx"
args = ["tsx", "./.tmp/mcp/FigmaMCP/src/index.ts"]
[mcp_servers.figma.env]
FIGMA_API_KEY = ""

[mcp_servers.container-use]
command = "container-use"
args = ["stdio"]

[mcp_servers.terraform]
command = "/go/bin/terraform-mcp-server"
args = ["stdio"]

# Add your trusted project paths here
# Example:
# [projects."/path/to/your/project"]
# trust_level = "trusted"
