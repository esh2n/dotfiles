// Tailnet policy file (HuJSON) for the home-LLM setup.
//
// This file does NOT take effect from the repo. Tailscale's policy file lives
// in the admin console (Access controls). This is the source the owner pastes
// there, or applies through GitOps (tailscale/gitops-acl-action: the file is
// committed as policy.hujson, `test` on pull requests, `apply` on push to main;
// https://tailscale.com/kb/1204/gitops-acls).
//
// What it grants: the OWNER'S OWN devices reach each other on every port
// (owner's ruling 2026-09-23: SSH, screen sharing and other connections
// between the owner's machines run over the tailnet too, so the policy does
// not enumerate ports). What it withholds: devices of other members, tagged
// devices and nodes shared in from another tailnet reach nothing. That is
// the "separation = tailnet membership" half of the decision record
// (domains/dev/llm/harness/rules/decisions/2026-09-23-home-llm-lm-studio-over-tailscale-litellm-local.md).
//
// The home-LLM services this must let through (all on 127.0.0.1, put on the
// tailnet with `tailscale serve`; "access control rules apply to Serve just
// like any other service", https://tailscale.com/kb/1312/serve):
//   tcp:1234  LM Studio on the Mac  — every other machine's LiteLLM reaches it
//   tcp:4001  LiteLLM's dedicated metrics listener on every machine — the
//             Mac's Prometheus scrapes it
//   tcp:3001  Open WebUI on the Mac — the phone's chat page (`--https`, a
//             PWA install needs a real certificate)
// LiteLLM's chat API (4000) is never served, so it is unreachable regardless
// of this file — that guarantee lives in `tailscale serve`, not here.
//
// "src: autogroup:member -> dst: autogroup:self" means: a user's devices may
// reach that same user's devices, and nothing else.
//
// Pasting this REPLACES the default allow-all policy (which also lets other
// members' devices in). Paste with `make tailscale-acl`.
//
// Syntax references: https://tailscale.com/kb/1018/acls (policy file, acls),
// https://tailscale.com/kb/1324/grants and https://tailscale.com/kb/1337/acl-syntax
// (grants: src / dst / ip as "protocol:port"; autogroup:member; autogroup:self).
{
	"grants": [
		// The owner's devices reach each other on every port (SSH, screen
		// sharing, the three LLM ports, whatever comes next); nobody else does.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},

		// The port-enumerating variant, if the ruling ever narrows again:
		// {
		// 	"src": ["autogroup:member"],
		// 	"dst": ["autogroup:self"],
		// 	"ip":  ["tcp:1234", "tcp:4001", "tcp:3001", "tcp:22"],
		// },
	],

	// Tag-based variant, if the machines are ever tagged instead of user-owned
	// (tagged devices are not "autogroup:self" of anyone). Direction-specific:
	// hub (the Mac) -> node:4001, node -> hub:1234.
	// "tagOwners": {
	// 	"tag:llm-hub":  ["autogroup:member"],
	// 	"tag:llm-node": ["autogroup:member"],
	// },
	// "grants": [
	// 	{ "src": ["tag:llm-hub"],  "dst": ["tag:llm-node"], "ip": ["tcp:4001"] },
	// 	{ "src": ["tag:llm-node"], "dst": ["tag:llm-hub"],  "ip": ["tcp:1234"] },
	// ],

	// Assertions the admin console (or the GitOps `test` step) evaluates
	// against the real tailnet. `make tailscale-acl` fills the placeholders
	// with the owner's login and the Mac's Tailscale IP. 4000 is not in a
	// `deny` here because the grant is port-agnostic; its guarantee is that
	// nothing ever runs `tailscale serve` for it.
	"tests": [
		{
			"src":    "owner@example.com",
			"accept": ["mac.example.ts.net:1234", "mac.example.ts.net:4001", "mac.example.ts.net:3001", "mac.example.ts.net:22"],
		},
	],
}
